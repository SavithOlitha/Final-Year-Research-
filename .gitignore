*.log

# -----------------------------
# AI artifacts / datasets (keep repo small)
# -----------------------------
raw/
composites/
*.pt
*.pth
*.onnx
*.tflite

# If you want to keep folder structure but ignore contents, use:
# raw/*
# !raw/.gitkeep
# composites/*
# !composites/.gitkeep

# -----------------------------
# PlatformIO / Arduino (device firmware)
# -----------------------------
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json

# Compiled binaries
*.elf
*.hex
*.bin

# -----------------------------
# Node / other (optional safety)
# -----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
