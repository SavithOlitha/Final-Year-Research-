*.py[cod]
*.pyd
*.pyo
*.pkl
*.joblib

# Virtual environments
.venv/
venv/
env/

# Python build artifacts
build/
dist/
*.egg-info/
.eggs/

# Jupyter / notebooks
.ipynb_checkpoints/

